# Copia este archivo a .env y ajusta los valores reales.
# NUNCA subas el archivo .env real a un repositorio.

DATABASE_URL="postgresql://sistema_tributario:cambia_esta_clave@localhost:5432/sistema_tributario?schema=public"

# Genera un valor largo y aleatorio real, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CAMBIAR_POR_UN_VALOR_ALEATORIO_LARGO"

PORT=3000
CORS_ORIGIN="http://localhost:5173,http://localhost:8080"

# En Vercel: NODE_ENV=production, CORS_ORIGIN con el dominio HTTPS exacto.
# DATABASE_URL debe incluir sslmode=require&sslaccept=strict.
# El registro público está cerrado por defecto cuando NODE_ENV=production.
ALLOW_PUBLIC_REGISTRATION=false
